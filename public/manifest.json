{
  "manifest_version": 3,
  "name": "Quoti",
  "description": "Transform social posts into elegant, shareable context cards.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Quoti"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content-script.js"],
      "css": ["assets/content-script.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://pbs.twimg.com/*"],
  "permissions": ["activeTab", "clipboardWrite", "contextMenus", "scripting", "storage", "tabs"]
}
