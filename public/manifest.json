{
  "manifest_version": 3,
  "name": "Quoti",
  "description": "Transform social posts into elegant, shareable context cards.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/quoti-icon-16.png",
    "32": "icons/quoti-icon-32.png",
    "48": "icons/quoti-icon-48.png",
    "128": "icons/quoti-icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/quoti-icon-16.png",
      "32": "icons/quoti-icon-32.png",
      "48": "icons/quoti-icon-48.png",
      "128": "icons/quoti-icon-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Quoti"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'self'; img-src 'self' data: https://pbs.twimg.com https://abs.twimg.com https://images.unsplash.com; media-src 'self' blob: https://video.twimg.com; connect-src 'self' https://video.twimg.com https://pbs.twimg.com https://abs.twimg.com https://images.unsplash.com http://127.0.0.1:* http://localhost:*;"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content-script.js"],
      "css": ["assets/content-script.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://pbs.twimg.com/*",
    "https://abs.twimg.com/*",
    "https://video.twimg.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "permissions": ["activeTab", "clipboardWrite", "contextMenus", "nativeMessaging", "scripting", "storage", "tabs", "webRequest"]
}
