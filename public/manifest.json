{
  "manifest_version": 3,
  "name": "Quoti",
  "description": "Transform social posts into elegant, shareable context cards.",
  "version": "0.1.3",
  "icons": {
    "16": "icons/quoti-icon-16.png",
    "32": "icons/quoti-icon-32.png",
    "48": "icons/quoti-icon-48.png",
    "128": "icons/quoti-icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/quoti-icon-16.png",
      "32": "icons/quoti-icon-32.png",
      "48": "icons/quoti-icon-48.png",
      "128": "icons/quoti-icon-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Quoti"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'self'; img-src 'self' data: https:; media-src 'self' blob: https:; connect-src 'self' https: http://127.0.0.1:* http://localhost:*;"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://threads.com/*",
        "https://www.threads.com/*",
        "https://threads.net/*",
        "https://www.threads.net/*",
        "https://linkedin.com/*",
        "https://www.linkedin.com/*",
        "https://facebook.com/*",
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*",
        "https://fb.watch/*"
      ],
      "js": [
        "content-script.js"
      ],
      "css": [
        "assets/content-script.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://threads.com/*",
    "https://www.threads.com/*",
    "https://threads.net/*",
    "https://www.threads.net/*",
    "https://linkedin.com/*",
    "https://www.linkedin.com/*",
    "https://facebook.com/*",
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://m.facebook.com/*",
    "https://fb.watch/*",
    "https://pbs.twimg.com/*",
    "https://abs.twimg.com/*",
    "https://video.twimg.com/*",
    "https://*.fbcdn.net/*",
    "https://*.cdninstagram.com/*",
    "https://media.licdn.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "contextMenus",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ]
}
